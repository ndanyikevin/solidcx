{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://solidcx.vercel.app/schema/component.schema.json",
  "title": "SolidCX Component Registry Entry",
  "description": "Schema for SolidCX component registry entries.",
  "type": "object",
  "required": [
    "name",
    "type",
    "title",
    "description",
    "files",
    "dependencies",
    "registryDependencies",
    "cssDependencies"
  ],
  "properties": {
      "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "type": {
      "type": "string",
      "enum": ["registry:ui"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "registryDependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "cssDependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "type"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["component", "style", "barrel", "utility"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
