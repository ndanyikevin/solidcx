{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solidcx.vercel.app/schema/registry.schema.json",
  "title": "SolidCX Registry",
  "description": "Schema for the SolidCX component registry.",
  "type": "object",
  "required": ["name", "version", "homepage", "components"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
